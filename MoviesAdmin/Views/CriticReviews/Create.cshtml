@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Create";
    var movies = (SelectList)ViewBag.MovieID;
}

<h1>Create</h1>

<h4>CriticReview</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>           

            <div class="mb-3">
                <label asp-for="MovieID" class="control-label">Movie</label>
                <select asp-for="MovieID" class="form-select" asp-items="ViewBag.MovieID"><option value="0">-- Select a movie --</option></select>
                <span asp-validation-for="MovieID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" style="resize: none;"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IsPublished" class="control-label"></label>
                <input asp-for="IsPublished" class="form-check-input" />
                <span asp-validation-for="IsPublished" class="text-danger"></span>
            </div>
            <hr/>
            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}