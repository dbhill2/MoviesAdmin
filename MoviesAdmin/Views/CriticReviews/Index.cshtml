@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Review</a>
</p>
<table class="table table-hover table-light table-striped-columns">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movie.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Movie.Title)
            </td>
            <td style="white-space: pre-line;">@item.Description?.Trim()</td>
            <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsPublished)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                <div class="d-flex flex-column gap-2">
                    @if (User.IsInRole("critic"))
                    {
                        @if (!item.IsPublished)
                        {
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-primary">Edit</a> 
                        }
                        <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-secondary">Details</a>
                        @if (!item.IsPublished)
                        {
                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-primary">Delete</a>
                        }
                        }
                        else if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-primary">Delete</a>
                        } else
                        {
                            
                        }

                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<p>
    <a asp-action="Create" class="btn btn-primary">Create Review</a>
</p>
