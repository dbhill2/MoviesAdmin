@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<br />

<div class="row">
    <div class="col-md-3">
        <img src="@Model.ImageUrl"
             alt="@Model.Title Poster"
             class="img-fluid rounded shadow" />
    </div>

    <div class="col-md-9">
        <table class="table table-light table-striped-columns">
            <tbody>
                <tr>
                    <th class="w-25">@Html.DisplayNameFor(m => m.Title)</th>
                    <td>@Html.DisplayFor(m => m.Title)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.Synopsis)</th>
                    <td>
                        <textarea class="form-control"
                            rows="10"
                            readonly
                            style="resize:none; background-color:whitesmoke; overflow-y:auto;">
                            @Model.Synopsis
                        </textarea>
                    </td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.Genre)</th>
                    <td>@Html.DisplayFor(m => m.Genre)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.Rating)</th>
                    <td>@Html.DisplayFor(m => m.Rating)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.RunTime)</th>
                    <td>@Html.DisplayFor(m => m.RunTime)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.ReleaseDate)</th>
                    <td>@Html.DisplayFor(m => m.ReleaseDate)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.NowPlaying)</th>
                    <td>@Html.DisplayFor(m => m.NowPlaying)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<br />

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
