@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<br />

<div class="row">
    <div class="col-md-3">
        <img src="@Model.ImageUrl"
             alt="@Model.Title Poster"
             class="img-fluid rounded shadow" />
    </div>

    <div class="col-md-9">
        <table class="table table-light table-striped-columns">
            <tbody>
                <tr>
                    <th class="w-25">@Html.DisplayNameFor(m => m.Title)</th>
                    <td>@Html.DisplayFor(m => m.Title)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.Synopsis)</th>
                    <td>
                        <textarea class="form-control"
                            rows="10"
                            readonly
                            style="resize:none; background-color:whitesmoke; overflow-y:auto;">@Model.Synopsis</textarea>
                    </td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.Genre)</th>
                    <td>@Html.DisplayFor(m => m.Genre.Title)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.AudienceRating)</th>
                    <td>@Html.DisplayFor(m => m.AudienceRating.Title)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.CriticReview)</th>
                    <td>
                        @Model.CriticReview.Count(r => r.IsPublished)
                        
                        @*Code to show the reviews with created date and author.     
                        @if (Model.CriticReview.Any())
                        {
                            foreach (var review in Model.CriticReview.Where(r => r.IsPublished))
                            {
                                <div class="mb-3">
                                    <div>
                                        <strong>@review.Rating / 5</strong>
                                        <small class="text-muted">
                                            by @review.CreatedBy on @review.CreatedDate.ToShortDateString()
                                        </small>
                                    </div>
                                    <p class="mb-0">@review.Description</p>
                                </div>
                            }
                        }
                        else
                        {
                            <em>No critic reviews yet.</em>
                        } *@
                    </td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.RunTime)</th>
                    <td>@Html.DisplayFor(m => m.RunTime)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.ReleaseDate)</th>
                    <td>@Html.DisplayFor(m => m.ReleaseDate)</td>
                </tr>

                <tr>
                    <th>@Html.DisplayNameFor(m => m.NowPlaying)</th>
                    <td>@Html.DisplayFor(m => m.NowPlaying)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<br />

<div>
    @if (User.IsInRole("admin")){
        <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-primary">Edit</a>
    }
    @if (User.IsInRole("critic"))
    {
        <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@Model.ID" class="btn btn-primary">Create Review</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
