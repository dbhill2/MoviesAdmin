@model List<MoviesAdmin.Models.Movie>

<h1>Movie Details</h1>

@foreach(var movie in Model){
<table class="table">
    @foreach (var prop in movie.GetType().GetProperties())
    {
        if (prop.Name != "ID")
        {
            <tr>
                <th>@prop.Name</th>
                <td>@prop.GetValue(movie)</td>
            </tr>
        }
    }
</table>
}